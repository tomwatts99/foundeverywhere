---
/**
 * Base.astro: the document shell.
 *
 * Owns: <html>, <head>, meta, OpenGraph, Twitter, canonical, hreflang,
 * fonts, theme-color, favicons, JSON-LD graph, skip link, and the
 * single global stylesheet import.
 *
 * Body content goes through {slot}. Higher-level layouts (Page.astro)
 * compose Base and inject Nav/Footer.
 */
import '../styles/global.css';
import { SITE } from '../lib/site';
import { orgSchema, websiteSchema, webPageSchema, graph } from '../lib/schema';

export interface Props {
  title: string;
  description?: string;
  /** Absolute or root-relative URL of this page. Used for canonical + JSON-LD. */
  path?: string;
  /** Path to an OG image under /public. Defaults to SITE.ogImage. */
  image?: string;
  /** ISO date for content publication (optional). */
  datePublished?: string;
  /** ISO date for content modification (optional). */
  dateModified?: string;
  /** Set to true on pages that should NOT be indexed. */
  noindex?: boolean;
  /** Optional extra JSON-LD entities to add to the graph (Article, Service, FAQPage, etc.). */
  schemaExtras?: Array<Record<string, unknown>>;
  /** Optional breadcrumb trail. */
  breadcrumb?: ReadonlyArray<{ name: string; item: string }>;
}

const {
  title,
  description = SITE.description,
  path = Astro.url.pathname,
  image = SITE.ogImage,
  datePublished,
  dateModified,
  noindex = false,
  schemaExtras = [],
  breadcrumb,
} = Astro.props;

const canonical = new URL(path, SITE.url).toString();
const ogImageUrl = new URL(image, SITE.url).toString();
const fullTitle = title.includes(SITE.name) ? title : `${title} | ${SITE.name}`;

/* The sitewide consultation CTA bar shows on every page EXCEPT the two
   pages where the visitor has already converted or is mid-conversion:
   the consultation page itself and the free report page. */
const ctaPath = path.replace(/\/$/, '') || '/';
const showConsultBar =
  ctaPath !== '/consultation' && ctaPath !== '/free-visibility-report';

const ld = graph(
  orgSchema(),
  websiteSchema(),
  webPageSchema({
    url: canonical,
    title,
    description,
    datePublished,
    dateModified,
    breadcrumb,
  }),
  ...schemaExtras,
);
---
<!doctype html>
<html lang={SITE.language}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />

    {/* Fonts are self-hosted under /public/fonts and declared via
        @font-face in global.css (no third-party DNS, no gstatic 404 risk).
        Preload only the LCP heading face (Outfit 700, latin) so the hero
        heading paints without waiting on the stylesheet; font-display:swap
        handles the rest. */}
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href="/fonts/outfit-700-latin.woff2"
      crossorigin
    />

    {/* Primary meta */}
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#0C7B82" />
    <meta name="color-scheme" content="light" />

    {/* Robots */}
    {noindex
      ? <meta name="robots" content="noindex, nofollow" />
      : <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    }

    {/* Open Graph */}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={SITE.locale} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${SITE.name}: ${SITE.tagline}`} />

    {/* Twitter / X */}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content={SITE.twitter} />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    {/* Favicons */}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/favicon-180.png" />
    <link rel="manifest" href="/site.webmanifest" />

    {/* Feeds + sitemap discovery */}
    <link rel="sitemap" type="application/xml" title="Sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="application/rss+xml" title={`${SITE.name}: Insights`} href="/rss.xml" />

    {/* JSON-LD graph: one connected entity model per page */}
    <script type="application/ld+json" set:html={JSON.stringify(ld)} />
  </head>

  <body>
    <a href="#main" class="skip-link">Skip to content</a>
    <slot />

    {showConsultBar && (
      <aside class="cta-bar" id="cta-bar" aria-label="Book a free consultation" hidden>
        <div class="container cta-bar__inner">
          <p class="cta-bar__text">Ready to improve your visibility?</p>
          <div class="cta-bar__actions">
            <a class="cta-bar__btn" href="/consultation/">Book a free consultation</a>
            <button class="cta-bar__close" type="button" aria-label="Dismiss" data-cta-dismiss>
              <svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round">
                <path d="m4 4 8 8M12 4l-8 8" />
              </svg>
            </button>
          </div>
        </div>
      </aside>

      <script is:inline>
        (function () {
          var bar = document.getElementById('cta-bar');
          if (!bar) return;
          var KEY = 'feConsultBarDismissed';
          try {
            if (sessionStorage.getItem(KEY) === '1') return; /* stay hidden this session */
          } catch (e) {}
          bar.hidden = false;
          /* Flag the body + global state so the Tidio launcher lifts clear of the bar. */
          document.body.classList.add('has-cta-bar');
          window.__feCtaBarVisible = true;
          if (window.feApplyTidioOffset) window.feApplyTidioOffset();
          var close = bar.querySelector('[data-cta-dismiss]');
          if (close) {
            close.addEventListener('click', function () {
              bar.hidden = true;
              document.body.classList.remove('has-cta-bar');
              window.__feCtaBarVisible = false;
              if (window.feApplyTidioOffset) window.feApplyTidioOffset();
              try { sessionStorage.setItem(KEY, '1'); } catch (e) {}
            });
          }
        })();
      </script>
    )}

    <script is:inline>
      (function () {
        /* Lift the Tidio launcher clear of the footer / consultation bar.
           Modern Tidio ignores host-page CSS on the widget, so we drive its
           position through the official tidioChatApi.adjustStyles() API.
           Tune these two values to taste (in px). */
        var TIDIO_BOTTOM_DEFAULT = 80;   /* clears the footer */
        var TIDIO_BOTTOM_WITH_BAR = 90;  /* sits just clear of the consultation bar */

        window.feApplyTidioOffset = function () {
          if (!window.tidioChatApi || !window.tidioChatApi.adjustStyles) return;
          var px = window.__feCtaBarVisible ? TIDIO_BOTTOM_WITH_BAR : TIDIO_BOTTOM_DEFAULT;
          window.tidioChatApi.adjustStyles('#tidio { bottom: ' + px + 'px !important; }');
        };

        function onTidioReady() { window.feApplyTidioOffset(); }
        if (window.tidioChatApi) {
          window.tidioChatApi.on('ready', onTidioReady);
        } else {
          document.addEventListener('tidioChat-ready', onTidioReady);
        }

        window.addEventListener('load', function () {
          var s = document.createElement('script');
          s.src = '//code.tidio.co/lwftxrlidrfr2qh7kvpy9fnqt4sctnr0.js';
          s.async = true;
          document.body.appendChild(s);
        });
      })();
    </script>
  </body>
</html>
