---
/**
 * report/[id].astro: the private AI visibility report.
 *
 * Rendered on demand (prerender = false). Reads the stored report
 * directly from the REPORTS KV binding on the Pages runtime, falling
 * back to an HTTP fetch of the Worker API in local dev. Missing reports
 * render a friendly 404 state. noindex / nofollow.
 */
export const prerender = false;

import Page from '../../layouts/Page.astro';

const { id } = Astro.params;

type DiscoveryResult = {
  query: string;
  response: string;
  appeared: boolean;
};
type GoogleResult = {
  keyword: string;
  position: number | string;
  found: boolean;
  topResults: { title: string; link: string }[];
};
type Recommendation = {
  title: string;
  description: string;
  priority: 'high' | 'medium' | 'low';
  effort: 'quick' | 'medium' | 'significant';
};
type Report = {
  id: string;
  firstName: string;
  businessName: string;
  websiteUrl: string;
  location: string;
  metaDescription?: string;
  serviceKeywords?: string[];
  discoveryQueries?: string[];
  discoveryResults?: DiscoveryResult[];
  appearanceCount?: number;
  discoveryScore?: number;
  googleResults?: GoogleResult[] | null;
  googleScore?: number | null;
  competitors?: string[];
  claudeBrandResponse?: string;
  brandScore?: number;
  chatgptBrandResponse?: string;
  chatgptBrandScore?: number;
  email: string;
  overallScore: number;
  recommendations: Recommendation[];
  generatedAt: string;
};

let report: Report | null = null;

// PRIMARY PATH — read straight from the KV binding.
//
// This page is itself a Cloudflare Pages Function, so it binds the SAME
// `REPORTS` namespace the Worker writes to and reads it in-process. No
// HTTP round-trip, which avoids the classic same-zone subrequest failure
// (a Pages Function fetching its own hostname loops back into Pages, which
// has no /api/report route, and returns a 404 → "Report not found").
const runtimeEnv = (Astro.locals as any)?.runtime?.env;

if (id && runtimeEnv?.REPORTS) {
  try {
    const raw = await runtimeEnv.REPORTS.get(`report:${id}`);
    if (raw) {
      report = JSON.parse(raw) as Report;
    } else {
      console.error(`[report] KV miss for key report:${id}`);
    }
  } catch (err) {
    console.error('[report] KV read failed:', err);
  }
}

// FALLBACK PATH — HTTP fetch to the Worker. Used in local dev (where the
// KV binding may be absent) or if the binding is not configured.
if (!report && id) {
  const API_ORIGIN = import.meta.env.PUBLIC_API_ORIGIN || 'https://foundeverywhere.co.uk';
  const apiUrl = `${API_ORIGIN}/api/report/${id}`;
  try {
    const res = await fetch(apiUrl);
    if (res.ok) {
      report = (await res.json()) as Report;
    } else {
      console.error(`[report] fetch ${apiUrl} → ${res.status} ${res.statusText}`);
    }
  } catch (err) {
    console.error(`[report] fetch ${apiUrl} failed:`, err);
  }
}

/* ---------- presentation helpers ---------- */
const RING_CIRC = 2 * Math.PI * 35; // 219.9

// New honest score bands: 0-25 red, 26-50 amber, 51-75 teal, 76-100 green.
function scoreColour(score: number): string {
  if (score <= 25) return '#EF4444';
  if (score <= 50) return '#F59E0B';
  if (score <= 75) return '#0C7B82';
  return '#16A34A';
}

function formatDate(iso: string): string {
  try {
    return new Date(iso).toLocaleDateString('en-GB', {
      day: 'numeric',
      month: 'long',
      year: 'numeric',
    });
  } catch {
    return '';
  }
}

const PRIORITY_LABEL = { high: 'High', medium: 'Medium', low: 'Low' } as const;
const EFFORT_LABEL = { quick: 'Quick win', medium: 'Medium', significant: 'Significant' } as const;

const overall = Math.round(report?.overallScore ?? 0);
const overallColour = scoreColour(overall);
const overallPct = Math.max(0, Math.min(1, overall / 100));
const overallOffset = RING_CIRC * (1 - overallPct);

// Live discovery — four unbranded searches; hard boolean appearance check.
const discoveryResults: DiscoveryResult[] = Array.isArray(report?.discoveryResults)
  ? report!.discoveryResults
  : [];
const appearanceCount =
  typeof report?.appearanceCount === 'number'
    ? report.appearanceCount
    : discoveryResults.filter((d) => d.appeared).length;
// Summary colour: 0 red, 1-2 amber, 3-4 teal.
const appearanceColour =
  appearanceCount === 0 ? '#EF4444' : appearanceCount <= 2 ? '#F59E0B' : '#0C7B82';

// Google rankings — null when SerpAPI was unavailable for this report.
const googleResults: GoogleResult[] | null = Array.isArray(report?.googleResults)
  ? report!.googleResults
  : null;
function domainOf(link: string): string {
  try {
    return new URL(link).hostname.replace(/^www\./i, '');
  } catch {
    return (link || '').replace(/^https?:\/\//i, '').replace(/^www\./i, '').split('/')[0];
  }
}
function googleTier(g: GoogleResult): 'top' | 'mid' | 'low' | 'none' {
  const pos = typeof g.position === 'number' ? g.position : null;
  if (!g.found || pos === null) return 'none';
  if (pos <= 3) return 'top';
  if (pos <= 6) return 'mid';
  return 'low';
}

// Competitors appearing instead — from Perplexity's live search only.
const competitors = Array.isArray(report?.competitors) ? report!.competitors : [];
const competitorsSub = report?.location
  ? `These businesses appeared in AI results for ${report.location} when customers searched the service category.`
  : 'These businesses appeared in AI results when customers searched the service category.';

// Brand awareness — what Claude / ChatGPT know from training data.
const brandScore = Math.round(report?.brandScore ?? 0);
const chatgptBrandScore = Math.round(report?.chatgptBrandScore ?? 0);
const claudeBrandResponse =
  report?.claudeBrandResponse || 'No response was returned for this check.';
const chatgptBrandResponse =
  report?.chatgptBrandResponse || 'No response was returned for this check.';

// Brand-section subheading — names the category, location and business.
const brandService = (report?.serviceKeywords || []).find((k) => !!k) || 'your service category';
const brandWhere = report?.location ? ` in ${report.location}` : '';
const brandSub = `We asked Claude and ChatGPT who they would recommend for ${brandService}${brandWhere} and checked whether ${report?.businessName ?? 'your business'} appeared.`;

/**
 * Fix 3 — clean and format an AI brand response for display. Strips bold
 * markers and markdown links, removes leading numbered-list markers, splits
 * into paragraphs on blank lines, and caps the output at ~300 words,
 * truncating at the last complete sentence (with a trailing ellipsis when
 * content was cut). Returns an array of paragraph strings to render as <p>.
 */
function formatBrandResponse(raw: string, maxWords = 300): string[] {
  let t = String(raw || '');
  if (!t.trim()) return [];
  // Strip markdown bold/italic markers.
  t = t
    .replace(/\*\*([^*]+)\*\*/g, '$1')
    .replace(/__([^_]+)__/g, '$1')
    .replace(/\*([^*]+)\*/g, '$1');
  // Strip markdown links [text](url) → text.
  t = t.replace(/\[([^\]]+)\]\([^)]*\)/g, '$1');

  // Split into paragraphs on blank lines; clean numbered markers per line.
  let chunks = t
    .split(/\n\s*\n/)
    .map((c) =>
      c
        .split('\n')
        .map((line) => line.replace(/^\s*\d+[.)]\s+/, '').trim())
        .filter(Boolean)
        .join(' ')
        .replace(/\s{2,}/g, ' ')
        .trim(),
    )
    .filter(Boolean);
  if (chunks.length === 0) chunks = [t.replace(/\s{2,}/g, ' ').trim()];

  // Word-cap across paragraphs, truncating the overflowing one at the last
  // complete sentence within the remaining budget.
  const out: string[] = [];
  let used = 0;
  for (const chunk of chunks) {
    const words = chunk.split(/\s+/);
    if (used + words.length <= maxWords) {
      out.push(chunk);
      used += words.length;
      continue;
    }
    const remaining = maxWords - used;
    let partial = words.slice(0, Math.max(0, remaining)).join(' ');
    const lastStop = Math.max(
      partial.lastIndexOf('.'),
      partial.lastIndexOf('!'),
      partial.lastIndexOf('?'),
    );
    if (lastStop > 0) partial = partial.slice(0, lastStop + 1);
    partial = partial.replace(/[.!?]+$/, '').trim();
    if (partial) out.push(partial + '…');
    break;
  }
  return out;
}

const claudeParagraphs = formatBrandResponse(claudeBrandResponse);
const chatgptParagraphs = formatBrandResponse(chatgptBrandResponse);
---

<Page
  title="Your Search and AI Visibility Report | Found Everywhere"
  description="Your private AI visibility report from Found Everywhere."
  path={`/report/${id}/`}
  noindex
  bleed
>
  {report === null ? (
    <section class="report-missing">
      <div class="container">
        <h1 class="report-missing__title">Report not found</h1>
        <p class="report-missing__lead">
          This report has expired or the link is incorrect. Reports are available
          for 30 days after they are generated.
        </p>
        <a href="/free-visibility-report/" class="report-missing__btn">
          Request a new report <span aria-hidden="true">&#x2197;</span>
        </a>
      </div>
    </section>
  ) : (
    <article class="report">
      <div class="report__wrap">
        <!-- Header -->
        <header class="report__header">
          <a href="/" class="report__brand" aria-label="Found Everywhere, home">
            <img src="/images/logo.svg" alt="Found Everywhere" width="146" height="40" />
          </a>
          <div class="report__heading">
            <div class="report__heading-top">
              <p class="report__kicker">Search and AI Visibility Report</p>
              <div class="report__actions">
                <button type="button" class="report__action" id="report-print">
                  <svg aria-hidden="true" viewBox="0 0 16 16" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M4 6V2.5h8V6" />
                    <path d="M4 12H2.5V6.5h11V12H12" />
                    <rect x="4.5" y="10" width="7" height="3.5" />
                  </svg>
                  Download PDF
                </button>
                <button type="button" class="report__action" id="report-copy" data-default="Copy report link">
                  <svg aria-hidden="true" viewBox="0 0 16 16" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M6.5 9.5a2.5 2.5 0 0 0 3.6.1l2-2a2.5 2.5 0 1 0-3.5-3.6l-1 1" />
                    <path d="M9.5 6.5a2.5 2.5 0 0 0-3.6-.1l-2 2a2.5 2.5 0 1 0 3.5 3.6l1-1" />
                  </svg>
                  <span class="report__action-label">Copy report link</span>
                </button>
              </div>
            </div>
            <p class="report__date">Generated {formatDate(report.generatedAt)}</p>
          </div>
        </header>

        <!-- Score hero -->
        <section class="report__score" aria-label="Overall AI visibility score">
          <div class="score-ring" style={`--ring-colour:${overallColour}`}>
            <svg class="score-ring__svg" viewBox="0 0 80 80" aria-hidden="true">
              <circle class="score-ring__track" cx="40" cy="40" r="35" />
              <circle
                class="score-ring__arc"
                cx="40"
                cy="40"
                r="35"
                style={`stroke-dasharray:${RING_CIRC.toFixed(1)};stroke-dashoffset:${overallOffset.toFixed(1)}`}
              />
            </svg>
            <span class="score-ring__value">{overall}</span>
          </div>
          <p class="report__score-label">Visibility Score</p>
          <p class="report__business">{report.businessName}</p>
          <p class="report__score-note">
            Scores are generated from live Google data and AI systems. They may vary
            slightly as search results and AI responses evolve.
          </p>
        </section>

        <!-- Live discovery -->
        <section class="report__discovery" aria-labelledby="discovery-title">
          <h2 id="discovery-title" class="report__section-title">Live AI search discovery</h2>
          <p class="report__section-sub">
            We ran 4 unbranded searches in Perplexity to see if your business appears
            when customers search without knowing your name.
          </p>
          <ul class="discovery-list">
            {discoveryResults.map((d) => (
              <li class:list={['discovery-row', d.appeared ? 'is-appeared' : 'is-missing']}>
                <span class="discovery-row__query">{d.query}</span>
                {d.appeared ? (
                  <span class="discovery-row__status discovery-row__status--yes">
                    <svg aria-hidden="true" viewBox="0 0 16 16" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M3.5 8.5l3 3 6-7" />
                    </svg>
                    Appeared
                  </span>
                ) : (
                  <span class="discovery-row__status discovery-row__status--no">
                    <svg aria-hidden="true" viewBox="0 0 16 16" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M4 4l8 8M12 4l-8 8" />
                    </svg>
                    Not found
                  </span>
                )}
              </li>
            ))}
          </ul>
          <p class="discovery-summary" style={`color:${appearanceColour}`}>
            Your business appeared in <strong>{appearanceCount}</strong> of 4 searches.
          </p>
        </section>

        <!-- Google rankings -->
        <section class="report__google" aria-labelledby="google-title">
          <h2 id="google-title" class="report__section-title">Google search rankings</h2>
          <p class="report__section-sub">Where you appear in Google for your key service searches.</p>
          {googleResults === null ? (
            <div class="google-empty">
              <p class="google-empty__text">
                Google ranking data was unavailable for this report. Run a new report to include Google rankings.
              </p>
            </div>
          ) : (
            <Fragment>
              <ul class="google-list">
                {googleResults.map((g) => {
                  const tier = googleTier(g);
                  return (
                    <li class="google-row">
                      <div class="google-row__head">
                        <span class="google-row__keyword">{g.keyword}</span>
                        <span class:list={['google-pos', `google-pos--${tier}`]}>
                          {tier === 'top' && (
                            <svg aria-hidden="true" viewBox="0 0 16 16" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                              <path d="M8 13V4M4 7.5 8 3.5l4 4" />
                            </svg>
                          )}
                          {g.found ? `Position ${g.position}` : 'Not in top 10'}
                        </span>
                      </div>
                      {g.topResults && g.topResults.length > 0 && (
                        <ul class="google-tops">
                          {g.topResults.map((r) => (
                            <li class="google-domain">{domainOf(r.link)}</li>
                          ))}
                        </ul>
                      )}
                    </li>
                  );
                })}
              </ul>
              <p class="report__google-note">
                Rankings shown are for UK Google search. Positions may vary by location and device.
              </p>
            </Fragment>
          )}
        </section>

        <!-- Competitors appearing instead -->
        {competitors.length > 0 && (
          <section class="report__competitors" aria-labelledby="competitors-title">
            <h2 id="competitors-title" class="report__competitors-title">Who appears when you do not</h2>
            <p class="report__section-sub">{competitorsSub}</p>
            <ul class="competitor-list">
              {competitors.map((c: string) => (
                <li class="competitor-pill">{c}</li>
              ))}
            </ul>
          </section>
        )}

        <!-- Brand awareness -->
        <section class="report__ai" aria-labelledby="brand-title" style="padding:64px 0;">
          <h2 id="brand-title" style="font-family:'Outfit',sans-serif;font-size:24px;font-weight:700;color:#0D1321;margin-bottom:8px;">What AI systems would recommend</h2>
          <p style="font-family:'Inter',sans-serif;font-size:15px;color:#64748B;margin-bottom:40px;">{brandSub}</p>

          <div class="brand-grid" style="display:grid;gap:20px;">
            <!-- Claude card -->
            <div class="brand-card" style="background:#fff;border:0.5px solid #E4E8EF;border-radius:12px;padding:24px;">
              <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:16px;padding-bottom:16px;border-bottom:0.5px solid #E4E8EF;">
                <span style="font-family:'Outfit',sans-serif;font-size:16px;font-weight:600;color:#0D1321;">Claude</span>
                <span style={`font-family:'Outfit',sans-serif;font-size:20px;font-weight:700;color:${scoreColour(brandScore)};`}>{brandScore}/100</span>
              </div>
              <div style="display:flex;flex-direction:column;gap:12px;margin-bottom:16px;">
                {claudeParagraphs.map((para) => (
                  <p style="font-family:'Inter',sans-serif;font-size:14px;color:#64748B;line-height:1.7;margin:0;">{para}</p>
                ))}
              </div>
              <span style="font-family:'JetBrains Mono',monospace;font-size:10px;color:#64748B;">Based on AI training data, not live search</span>
            </div>

            <!-- ChatGPT card -->
            <div class="brand-card" style="background:#fff;border:0.5px solid #E4E8EF;border-radius:12px;padding:24px;">
              <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:16px;padding-bottom:16px;border-bottom:0.5px solid #E4E8EF;">
                <span style="font-family:'Outfit',sans-serif;font-size:16px;font-weight:600;color:#0D1321;">ChatGPT</span>
                <span style={`font-family:'Outfit',sans-serif;font-size:20px;font-weight:700;color:${scoreColour(chatgptBrandScore)};`}>{chatgptBrandScore}/100</span>
              </div>
              <div style="display:flex;flex-direction:column;gap:12px;margin-bottom:16px;">
                {chatgptParagraphs.map((para) => (
                  <p style="font-family:'Inter',sans-serif;font-size:14px;color:#64748B;line-height:1.7;margin:0;">{para}</p>
                ))}
              </div>
              <span style="font-family:'JetBrains Mono',monospace;font-size:10px;color:#64748B;">Based on AI training data, not live search</span>
            </div>
          </div>

          <p style="font-family:'Inter',sans-serif;font-size:13px;color:#64748B;line-height:1.6;margin-top:20px;">Brand awareness scores show what Claude and ChatGPT would recommend in your service category. If your business does not appear it means AI systems are not yet confident enough in your authority to recommend you. This can be improved by building third-party mentions, directory listings, and press coverage.</p>
        </section>

        <!-- Recommendations -->
        <section class="report__recs" aria-labelledby="recs-title">
          <h2 id="recs-title" class="report__recs-title">Your top 5 recommendations</h2>
          <div class="report__recs-list">
            {report.recommendations.map((rec, i) => (
              <div class="rec-card">
                <div class="rec-card__top">
                  <span class="rec-card__num">{String(i + 1).padStart(2, '0')}</span>
                  <div class="rec-card__badges">
                    <span class:list={['badge', `badge--prio-${rec.priority}`]}>
                      {PRIORITY_LABEL[rec.priority]}
                    </span>
                    <span class="badge badge--effort">{EFFORT_LABEL[rec.effort]}</span>
                  </div>
                </div>
                <h3 class="rec-card__title">{rec.title}</h3>
                <p class="rec-card__body">{rec.description}</p>
              </div>
            ))}
          </div>
        </section>

        <!-- CTA -->
        <section class="report__cta">
          <h2 class="report__cta-title">Ready to improve your score?</h2>
          <p class="report__cta-lead">
            Found Everywhere can implement every recommendation in this report. Get in
            touch and we will tell you exactly what is involved.
          </p>
          <a href="/contact/" class="report__cta-btn">
            Book a free consultation <span aria-hidden="true" class="report__cta-arrow">&#x2197;</span>
          </a>
        </section>
      </div>
    </article>
  )}
</Page>

<script>
  // Download PDF — uses the browser print dialog + @media print stylesheet.
  const printBtn = document.getElementById('report-print');
  if (printBtn) {
    printBtn.addEventListener('click', () => window.print());
  }

  // Copy report link — writes the current URL to the clipboard and shows
  // transient confirmation feedback.
  const copyBtn = document.getElementById('report-copy');
  if (copyBtn) {
    const label = copyBtn.querySelector('.report__action-label') as HTMLElement | null;
    const original = label ? label.textContent : '';
    let timer: number | undefined;
    copyBtn.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(window.location.href);
      } catch {
        const ta = document.createElement('textarea');
        ta.value = window.location.href;
        ta.style.position = 'fixed';
        ta.style.opacity = '0';
        document.body.appendChild(ta);
        ta.select();
        try { document.execCommand('copy'); } catch {}
        document.body.removeChild(ta);
      }
      if (label) {
        label.textContent = 'Link copied!';
        copyBtn.classList.add('is-copied');
        window.clearTimeout(timer);
        timer = window.setTimeout(() => {
          label.textContent = original;
          copyBtn.classList.remove('is-copied');
        }, 2000);
      }
    });
  }
</script>

<style>
  /* ============================================================
     MISSING / 404 STATE
     ============================================================ */
  .report-missing {
    background: #FFFFFF;
    text-align: center;
    padding-block: clamp(64px, 10vw, 120px);
  }
  .report-missing__title {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(28px, 1.6rem + 2vw, 40px);
    line-height: 1.1;
    letter-spacing: -0.02em;
    color: #0D1321;
  }
  .report-missing__lead {
    margin: 16px auto 0;
    max-width: 36rem;
    font-family: var(--font-body);
    font-size: 16px;
    line-height: 1.6;
    color: #64748B;
  }
  .report-missing__btn {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    margin-top: 28px;
    padding: 13px 24px;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 15px;
    color: #FFFFFF;
    background: #0C7B82;
    border-radius: 8px;
    text-decoration: none;
  }
  .report-missing__btn:hover { background: #0A6970; }

  /* ============================================================
     REPORT SHELL
     ============================================================ */
  .report { background: #FFFFFF; }
  .report__wrap {
    max-width: 960px;
    margin-inline: auto;
    padding: 64px var(--gutter);
  }

  /* ---------- Header ---------- */
  .report__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding-bottom: 20px;
    border-bottom: 1px solid #E4E8EF;
  }
  .report__brand { display: inline-flex; align-items: center; line-height: 0; }
  .report__brand img { display: block; height: 40px; width: auto; }
  .report__heading { text-align: right; }
  .report__heading-top {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 16px;
  }
  .report__kicker {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 15px;
    color: #0D1321;
  }
  .report__actions { display: flex; align-items: center; gap: 8px; }
  .report__action {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 8px 16px;
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 13px;
    line-height: 1;
    color: #0D1321;
    background: #FFFFFF;
    border: 1px solid #E4E8EF;
    border-radius: 8px;
    cursor: pointer;
    transition:
      border-color var(--duration-fast) var(--ease-out),
      background-color var(--duration-fast) var(--ease-out),
      color var(--duration-fast) var(--ease-out);
  }
