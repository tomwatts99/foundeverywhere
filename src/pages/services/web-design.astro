---
export const prerender = true;

/**
 * services/web-design.astro: detail page for the web design service.
 *
 * Schema flow: FAQPage built from the same WD_FAQS source rendered
 * on-page, plus a BreadcrumbList (Home > Services > this page). Both
 * flow through schemaExtras into the single <head> @graph.
 */
import Page from '../../layouts/Page.astro';
import FAQItem from '../../components/ui/FAQItem.astro';
import CTABlock from '../../components/sections/CTABlock.astro';
import { faqPageSchema, breadcrumbSchema } from '../../lib/schema';
import { SITE } from '../../lib/site';

const FEATURES = [
  {
    num: '01',
    title: 'Discovery and brief',
    body: 'We get under the skin of your business, your customers, and what you need the site to do. Goals first, design second.',
  },
  {
    num: '02',
    title: 'Design and build',
    body: 'Clean, fast, modern design built on a solid technical foundation. Structured for search engines and AI discovery from day one.',
  },
  {
    num: '03',
    title: 'Structured data as standard',
    body: 'Schema markup included on every page so search engines and AI systems understand exactly what your business does and where you are.',
  },
  {
    num: '04',
    title: 'Speed optimisation',
    body: 'Built to load fast on mobile and desktop. Page speed is a ranking factor and a conversion factor - we treat it as both.',
  },
  {
    num: '05',
    title: 'Content structure',
    body: 'Heading hierarchy, internal linking, and page structure built to help both users and search engines navigate your site.',
  },
  {
    num: '06',
    title: 'Launch and handover',
    body: 'We make sure everything is set up correctly before launch and hand over with clear documentation so you can manage the site confidently.',
  },
] as const;

const STANDARDS = [
  {
    title: 'Search performance',
    body: 'A fast, well-structured site with clean code and proper schema gives Google and AI systems exactly what they need to rank and recommend you.',
  },
  {
    title: 'Conversion',
    body: 'A site that loads quickly, communicates clearly, and is easy to navigate converts more visitors into enquiries - regardless of where the traffic comes from.',
  },
  {
    title: 'Longevity',
    body: 'Built on modern, maintainable foundations rather than bloated page builders. Faster, more secure, and easier to update as your business grows.',
  },
] as const;

const WD_FAQS = [
  {
    question: 'What platform do you build on?',
    answer:
      'We build on the right platform for your needs - we are not tied to any one technology. What matters is that the result is fast, maintainable, and built to perform in search.',
  },
  {
    question: 'Do you redesign existing sites or only build new ones?',
    answer:
      'Both. Sometimes a rebuild from scratch is the right answer. Often we can take an existing site and significantly improve its performance and structure without starting over.',
  },
  {
    question: 'Is SEO included?',
    answer:
      'Site structure, page speed, schema markup, and technical SEO foundations are built in as standard. Ongoing SEO and content work is a separate service.',
  },
  {
    question: 'How long does a build take?',
    answer:
      'Most projects take four to eight weeks from brief to launch depending on scope and how quickly feedback and content come back from you.',
  },
  {
    question: 'Do we need to provide copy and images?',
    answer:
      'We can work with content you provide or help you create it. We will advise on what is needed and what will perform best in search.',
  },
  {
    question: 'How do we get started?',
    answer:
      'Get in touch and tell us about your business and what you need. We will have a conversation about scope and what the right approach looks like.',
  },
];

const pageUrl = `${SITE.url}/services/web-design/`;
const schemaExtras = [
  faqPageSchema(WD_FAQS, pageUrl),
  breadcrumbSchema(
    [
      { name: 'Home',       item: `${SITE.url}/` },
      { name: 'Services',   item: `${SITE.url}/services/` },
      { name: 'Web Design', item: pageUrl },
    ],
    pageUrl,
  ),
];
---

<Page
  title="Web Design Service UK | Found Everywhere"
  description="Fast, modern websites built for search and AI visibility from the ground up. No bloated templates. No slow load times. Just clean, effective sites that rank and convert."
  path="/services/web-design/"
  schemaExtras={schemaExtras}
  bleed
>

  <!-- ============ 1. HERO ============ -->
  <section class="ec-hero" aria-labelledby="ec-hero-title">
    <div class="container">
      <p class="ec-hero__eyebrow">Web Design</p>
      <h1 id="ec-hero-title" class="ec-hero__title">Websites built to be found</h1>
      <p class="ec-hero__lead">
        Fast, modern websites designed and built for search performance
        and AI visibility from the ground up - not retrofitted as an
        afterthought.
      </p>
      <div class="ec-hero__cta">
        <a href="/consultation/" class="ec-btn ec-btn--primary">
          Book a free consultation <span aria-hidden="true" class="ec-btn__arrow">&#x2197;</span>
        </a>
        <a href="/services/" class="ec-btn ec-btn--ghost">See all services</a>
      </div>
    </div>
  </section>

  <!-- ============ 2. THE PROBLEM ============ -->
  <section class="ec-problem" aria-labelledby="ec-problem-title">
    <div class="container">
      <p class="ec-problem__eyebrow">The problem</p>
      <h2 id="ec-problem-title" class="ec-problem__title">Most websites are built to look good and left to figure out the rest</h2>
      <p class="ec-problem__body">
        A website that looks great but loads slowly, has no structured
        data, and isn't optimised for search is a missed opportunity.
        Google and AI systems are making judgements about your site every
        time someone searches for what you do.
      </p>
      <p class="ec-problem__body">
        Speed, structure, and content signals all feed into whether you
        appear - or whether a competitor does instead.
      </p>
    </div>
  </section>

  <!-- ============ 3. WHAT WE DO ============ -->
  <section class="ec-do" aria-labelledby="ec-do-title">
    <div class="container">
      <p class="ec-do__eyebrow">What is included</p>
      <h2 id="ec-do-title" class="ec-do__title">A site built to perform from day one</h2>

      <ul class="ec-features" role="list">
        {FEATURES.map((f) => (
          <li class="ec-feature">
            <span class="ec-feature__num">{f.num}</span>
            <h3 class="ec-feature__title">{f.title}</h3>
            <p class="ec-feature__body">{f.body}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- ============ 4. THE STANDARD (dark) ============ -->
  <section class="ec-std" aria-labelledby="ec-std-title">
    <div class="container">
      <p class="ec-std__eyebrow">Why it matters</p>
      <h2 id="ec-std-title" class="ec-std__title">What a well-built site actually delivers</h2>

      <div class="ec-std__grid">
        {STANDARDS.map((s) => (
          <article class="ec-std-card">
            <h3 class="ec-std-card__title">{s.title}</h3>
            <p class="ec-std-card__body">{s.body}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- ============ 5. FAQ ============ -->
  <section class="ec-faq" aria-labelledby="ec-faq-title">
    <div class="container">
      <p class="ec-faq__eyebrow">Common questions</p>
      <h2 id="ec-faq-title" class="ec-faq__title">What people ask about web design</h2>
      <div class="ec-faq__list">
        {WD_FAQS.map((faq) => (
          <FAQItem question={faq.question} answer={faq.answer} />
        ))}
      </div>
    </div>
  </section>

  <!-- ============ 6. CTA ============ -->
  <CTABlock />

</Page>

<style>
  /* ============================================================
     1. HERO
     ============================================================ */
  .ec-hero {
    background: #0D1826;
    color: #FFFFFF;
    text-align: center;
    padding-block: 96px;
  }
  .ec-hero__eyebrow {
    margin: 0 0 20px;
    font-family: var(--font-mono);
    font-size: 11px;
    line-height: 1;
    color: #3FA9B0;
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }
  .ec-hero__title {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(34px, 1.6rem + 3.6vw, 52px);
    line-height: 1.1;
    letter-spacing: -0.02em;
    color: #FFFFFF;
    text-wrap: balance;
  }
  .ec-hero__lead {
    margin: 20px auto 0;
    max-width: 560px;
    font-family: var(--font-body);
    font-weight: 400;
    font-size: 17px;
    line-height: 1.65;
    color: #94A3B8;
    text-wrap: pretty;
  }
  .ec-hero__cta {
    margin-top: 32px;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px;
  }
  .ec-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 13px 22px;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 15px;
    line-height: 1;
    border-radius: 8px;
    text-decoration: none;
    transition:
      background-color var(--duration-fast) var(--ease-out),
      border-color var(--duration-fast) var(--ease-out),
      color var(--duration-fast) var(--ease-out);
  }
  .ec-btn--primary {
    color: #FFFFFF;
    background: #0C7B82;
    border: 1px solid #0C7B82;
  }
  .ec-btn--primary:hover { background: #0A6970; border-color: #0A6970; }
  .ec-btn--ghost {
    color: #FFFFFF;
    background: transparent;
    border: 1px solid rgba(255, 255, 255, 0.25);
  }
  .ec-btn--ghost:hover { border-color: rgba(255, 255, 255, 0.55); }
  .ec-btn__arrow {
    display: inline-block;
    transition: transform var(--duration-base) var(--ease-out);
  }
  .ec-btn--primary:hover .ec-btn__arrow { transform: translate(2px, -2px); }

  /* ============================================================
     2. THE PROBLEM
     ============================================================ */
  .ec-problem {
    background: #F7F9FC;
    padding-block: 96px;
    text-align: center;
  }
  .ec-problem .container { max-width: 800px; }
  .ec-problem__eyebrow {
    margin: 0 0 16px;
    font-family: var(--font-mono);
    font-size: 11px;
    line-height: 1;
    color: #0A6A70;
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }
  .ec-problem__title {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(24px, 1.3rem + 1.4vw, 32px);
    line-height: 1.2;
    letter-spacing: -0.02em;
    color: #0D1321;
    text-wrap: balance;
  }
  .ec-problem__body {
    margin: 24px auto 0;
    max-width: 640px;
    font-family: var(--font-body);
    font-weight: 400;
    font-size: 17px;
    line-height: 1.75;
    color: #525D6B;
    text-wrap: pretty;
  }

  /* ============================================================
     3. WHAT WE DO
     ============================================================ */
  .ec-do { background: #FFFFFF; padding-block: 96px; }
  .ec-do .container { max-width: 960px; }
  .ec-do__eyebrow {
    margin: 0 0 16px;
    font-family: var(--font-mono);
    font-size: 11px;
    line-height: 1;
    color: #0A6A70;
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }
  .ec-do__title {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(28px, 1.5rem + 1.6vw, 36px);
    line-height: 1.15;
    letter-spacing: -0.02em;
    color: #0D1321;
    text-wrap: balance;
  }
  .ec-features {
    list-style: none;
    padding: 0;
    margin: 48px 0 0;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 32px;
  }
  .ec-feature__num {
    display: block;
    font-family: var(--font-mono);
    font-weight: 500;
    font-size: 11px;
    line-height: 1;
    color: #0A6A70;
    letter-spacing: 0.08em;
  }
  .ec-feature__title {
    margin: 8px 0 0;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 18px;
    line-height: 1.3;
    letter-spacing: -0.01em;
    color: #0D1321;
  }
  .ec-feature__body {
    margin: 8px 0 0;
    font-family: var(--font-body);
    font-weight: 400;
    font-size: 15px;
    line-height: 1.65;
    color: #525D6B;
    text-wrap: pretty;
  }

  /* ============================================================
     4. THE STANDARD (dark)
     ============================================================ */
  .ec-std { background: #0D1826; padding-block: 96px; }
  .ec-std .container { max-width: 960px; }
  .ec-std__eyebrow {
    margin: 0 0 16px;
    text-align: center;
    font-family: var(--font-mono);
    font-size: 11px;
    line-height: 1;
    color: #3FA9B0;
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }
  .ec-std__title {
    margin: 0;
    text-align: center;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(28px, 1.5rem + 1.6vw, 36px);
    line-height: 1.2;
    letter-spacing: -0.02em;
    color: #FFFFFF;
    text-wrap: balance;
  }
  .ec-std__grid {
    margin-top: 48px;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }
  .ec-std-card {
    background: #0A1520;
    border: 0.5px solid #1E3A4A;
    border-radius: 16px;
    padding: 28px;
  }
  .ec-std-card__title {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 18px;
    line-height: 1.3;
    letter-spacing: -0.01em;
    color: #FFFFFF;
  }
  .ec-std-card__body {
    margin: 10px 0 0;
    font-family: var(--font-body);
    font-weight: 400;
    font-size: 14px;
    line-height: 1.65;
    color: #94A3B8;
    text-wrap: pretty;
  }

  /* ============================================================
     5. FAQ
     ============================================================ */
  .ec-faq { background: #FFFFFF; padding-block: 96px; }
  .ec-faq .container { max-width: 800px; }
  .ec-faq__eyebrow {
    margin: 0 0 16px;
    font-family: var(--font-mono);
    font-size: 11px;
    line-height: 1;
    color: #0A6A70;
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }
  .ec-faq__title {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(28px, 1.5rem + 1.6vw, 36px);
    line-height: 1.15;
    letter-spacing: -0.02em;
    color: #0D1321;
    text-wrap: balance;
  }
  .ec-faq__list {
    margin-top: 48px;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  /* ============================================================
     RESPONSIVE
     ============================================================ */
  @media (max-width: 56rem) {
    .ec-features { grid-template-columns: 1fr; gap: 28px; }
    .ec-std__grid { grid-template-columns: 1fr; }
  }
  @media (max-width: 48rem) {
    .ec-hero    { padding-block: 72px; }
    .ec-problem { padding-block: 72px; }
    .ec-do      { padding-block: 72px; }
    .ec-std     { padding-block: 72px; }
    .ec-faq     { padding-block: 72px; }
  }
</style>
