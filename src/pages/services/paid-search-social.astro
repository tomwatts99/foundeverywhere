---
export const prerender = true;

/**
 * services/paid-search-social.astro: detail page for the paid search
 * and social service. Slug matches the nav/footer link
 * (/services/paid-search-social/).
 *
 * Schema flow: FAQPage built from the same PS_FAQS source rendered
 * on-page, plus a BreadcrumbList (Home > Services > this page). Both
 * flow through schemaExtras into the single <head> @graph.
 */
import Page from '../../layouts/Page.astro';
import FAQItem from '../../components/ui/FAQItem.astro';
import CTABlock from '../../components/sections/CTABlock.astro';
import { faqPageSchema, breadcrumbSchema } from '../../lib/schema';
import { SITE } from '../../lib/site';

const FEATURES = [
  {
    num: '01',
    title: 'Audit and strategy',
    body: 'We review your current paid activity if you have any, identify where the opportunities are, and build a strategy around your goals and budget.',
  },
  {
    num: '02',
    title: 'Campaign build',
    body: 'We set up campaigns built for performance from day one - the right structure, targeting, ad copy, and landing pages to get the best possible return.',
  },
  {
    num: '03',
    title: 'Google Ads',
    body: 'Search campaigns targeting people actively searching for your services. The highest-intent channel for most businesses.',
  },
  {
    num: '04',
    title: 'Meta (Facebook and Instagram)',
    body: 'Awareness, retargeting, and prospecting campaigns. Particularly effective for B2C, local businesses, and visual products.',
  },
  {
    num: '05',
    title: 'LinkedIn',
    body: 'B2B targeting by job title, industry, and company size. The right channel for professional services, SaaS, and businesses selling to other businesses.',
  },
  {
    num: '06',
    title: 'Ongoing optimisation and reporting',
    body: 'Monthly reporting on what is working, what isn\'t, and where the budget is going. Campaigns optimised continuously rather than set and forgotten.',
  },
] as const;

const STANDARDS = [
  {
    title: 'Immediate visibility',
    body: 'Paid search puts you at the top of results from day one - no waiting for organic rankings to build. Particularly valuable for new businesses or new service launches.',
  },
  {
    title: 'Precision targeting',
    body: 'Reach exactly the right people - by search term, location, demographic, job title, or interest. Every pound of budget working as hard as possible.',
  },
  {
    title: 'Measurable return',
    body: 'Every click, enquiry, and conversion tracked. You know exactly what your campaigns are delivering and where the money is going.',
  },
] as const;

const PS_FAQS = [
  {
    question: 'What budget do I need?',
    answer:
      'It depends on your industry and goals. We will advise on realistic budgets for your sector and won\'t take on campaigns where the budget isn\'t sufficient to get meaningful results.',
  },
  {
    question: 'Do you manage campaigns or just set them up?',
    answer:
      'We manage campaigns on an ongoing basis - setup and walk away isn\'t something we offer. Paid campaigns need continuous optimisation to perform.',
  },
  {
    question: 'Which platform should I start with?',
    answer:
      'For most local businesses, Google Ads first. If you\'re B2B, LinkedIn. If you\'re selling visually or need to build awareness, Meta. We will advise on the right starting point for your specific situation.',
  },
  {
    question: 'Can paid ads work alongside SEO?',
    answer:
      'Yes - and they work better together. Paid fills the gap while organic builds. Retargeting campaigns also convert people who found you organically but didn\'t enquire first time.',
  },
  {
    question: 'How do you measure success?',
    answer:
      'We agree on the right metrics upfront - usually cost per lead or cost per acquisition rather than clicks or impressions. Vanity metrics don\'t pay your bills.',
  },
  {
    question: 'How do we get started?',
    answer:
      'Get in touch and tell us about your business and your goals. We will review your current situation and tell you honestly whether paid search is the right move right now.',
  },
];

const pageUrl = `${SITE.url}/services/paid-search-social/`;
const schemaExtras = [
  faqPageSchema(PS_FAQS, pageUrl),
  breadcrumbSchema(
    [
      { name: 'Home',                  item: `${SITE.url}/` },
      { name: 'Services',              item: `${SITE.url}/services/` },
      { name: 'Paid Search & Social',  item: pageUrl },
    ],
    pageUrl,
  ),
];
---

<Page
  title="Paid Search & Social Service UK | Found Everywhere"
  description="Paid search and social campaigns across Google, Meta, and LinkedIn. Targeted to the right audience, optimised for leads, and managed to get the best return on your budget."
  path="/services/paid-search-social/"
  schemaExtras={schemaExtras}
  bleed
>

  <!-- ============ 1. HERO ============ -->
  <section class="ec-hero" aria-labelledby="ec-hero-title">
    <div class="container">
      <p class="ec-hero__eyebrow">Paid Search &amp; Social</p>
      <h1 id="ec-hero-title" class="ec-hero__title">Show up from day one</h1>
      <p class="ec-hero__lead">
        While your organic and AI visibility builds, paid campaigns across
        Google, Meta, and LinkedIn put you in front of the right audience
        immediately.
      </p>
      <div class="ec-hero__cta">
        <a href="/contact/" class="ec-btn ec-btn--primary">
          Get in touch <span aria-hidden="true" class="ec-btn__arrow">&#x2197;</span>
        </a>
        <a href="/services/" class="ec-btn ec-btn--ghost">See all services</a>
      </div>
    </div>
  </section>

  <!-- ============ 2. THE PROBLEM ============ -->
  <section class="ec-problem" aria-labelledby="ec-problem-title">
    <div class="container">
      <p class="ec-problem__eyebrow">The problem</p>
      <h2 id="ec-problem-title" class="ec-problem__title">Organic visibility takes time. You need leads now.</h2>
      <p class="ec-problem__body">
        SEO and AI visibility are long-term investments that compound over
        time. But most businesses need enquiries coming in while that
        foundation is being built.
      </p>
      <p class="ec-problem__body">
        Paid search and social fills the gap - putting you in front of
        people actively searching for what you offer, and in front of
        audiences who don't know you exist yet but should.
      </p>
    </div>
  </section>

  <!-- ============ 3. WHAT WE DO ============ -->
  <section class="ec-do" aria-labelledby="ec-do-title">
    <div class="container">
      <p class="ec-do__eyebrow">What is included</p>
      <h2 id="ec-do-title" class="ec-do__title">Campaigns built around your visibility goals</h2>

      <ul class="ec-features" role="list">
        {FEATURES.map((f) => (
          <li class="ec-feature">
            <span class="ec-feature__num">{f.num}</span>
            <h3 class="ec-feature__title">{f.title}</h3>
            <p class="ec-feature__body">{f.body}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- ============ 4. THE STANDARD (dark) ============ -->
  <section class="ec-std" aria-labelledby="ec-std-title">
    <div class="container">
      <p class="ec-std__eyebrow">Why it matters</p>
      <h2 id="ec-std-title" class="ec-std__title">What good paid campaigns actually deliver</h2>

      <div class="ec-std__grid">
        {STANDARDS.map((s) => (
          <article class="ec-std-card">
            <h3 class="ec-std-card__title">{s.title}</h3>
            <p class="ec-std-card__body">{s.body}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- ============ 5. FAQ ============ -->
  <section class="ec-faq" aria-labelledby="ec-faq-title">
    <div class="container">
      <p class="ec-faq__eyebrow">Common questions</p>
      <h2 id="ec-faq-title" class="ec-faq__title">What people ask about paid search and social</h2>
      <div class="ec-faq__list">
        {PS_FAQS.map((faq) => (
          <FAQItem question={faq.question} answer={faq.answer} />
        ))}
      </div>
    </div>
  </section>

  <!-- ============ 6. CTA ============ -->
  <CTABlock />

</Page>

<style>
  /* ============================================================
     1. HERO
     ============================================================ */
  .ec-hero {
    background: #0D1826;
    color: #FFFFFF;
    text-align: center;
    padding-block: 96px;
  }
  .ec-hero__eyebrow {
    margin: 0 0 20px;
    font-family: var(--font-mono);
    font-size: 11px;
    line-height: 1;
    color: #0C7B82;
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }
  .ec-hero__title {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(34px, 1.6rem + 3.6vw, 52px);
    line-height: 1.1;
    letter-spacing: -0.02em;
    color: #FFFFFF;
    text-wrap: balance;
  }
  .ec-hero__lead {
    margin: 20px auto 0;
    max-width: 560px;
    font-family: var(--font-body);
    font-weight: 400;
    font-size: 17px;
    line-height: 1.65;
    color: #94A3B8;
    text-wrap: pretty;
  }
  .ec-hero__cta {
    margin-top: 32px;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px;
  }
  .ec-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 13px 22px;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 15px;
    line-height: 1;
    border-radius: 8px;
    text-decoration: none;
    transition:
      background-color var(--duration-fast) var(--ease-out),
      border-color var(--duration-fast) var(--ease-out),
      color var(--duration-fast) var(--ease-out);
  }
  .ec-btn--primary {
    color: #FFFFFF;
    background: #0C7B82;
    border: 1px solid #0C7B82;
  }
  .ec-btn--primary:hover { background: #0A6970; border-color: #0A6970; }
  .ec-btn--ghost {
    color: #FFFFFF;
    background: transparent;
    border: 1px solid rgba(255, 255, 255, 0.25);
  }
  .ec-btn--ghost:hover { border-color: rgba(255, 255, 255, 0.55); }
  .ec-btn__arrow {
    display: inline-block;
    transition: transform var(--duration-base) var(--ease-out);
  }
  .ec-btn--primary:hover .ec-btn__arrow { transform: translate(2px, -2px); }

  /* ============================================================
     2. THE PROBLEM
     ============================================================ */
  .ec-problem {
    background: #F7F9FC;
    padding-block: 96px;
    text-align: center;
  }
  .ec-problem .container { max-width: 800px; }
  .ec-problem__eyebrow {
    margin: 0 0 16px;
    font-family: var(--font-mono);
    font-size: 11px;
    line-height: 1;
    color: #0C7B82;
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }
  .ec-problem__title {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(24px, 1.3rem + 1.4vw, 32px);
    line-height: 1.2;
    letter-spacing: -0.02em;
    color: #0D1321;
    text-wrap: balance;
  }
  .ec-problem__body {
    margin: 24px auto 0;
    max-width: 640px;
    font-family: var(--font-body);
    font-weight: 400;
    font-size: 17px;
    line-height: 1.75;
    color: #64748B;
    text-wrap: pretty;
  }

  /* ============================================================
     3. WHAT WE DO
     ============================================================ */
  .ec-do { background: #FFFFFF; padding-block: 96px; }
  .ec-do .container { max-width: 960px; }
  .ec-do__eyebrow {
    margin: 0 0 16px;
    font-family: var(--font-mono);
    font-size: 11px;
    line-height: 1;
    color: #0C7B82;
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }
  .ec-do__title {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(28px, 1.5rem + 1.6vw, 36px);
    line-height: 1.15;
    letter-spacing: -0.02em;
    color: #0D1321;
    text-wrap: balance;
  }
  .ec-features {
    list-style: none;
    padding: 0;
    margin: 48px 0 0;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 32px;
  }
  .ec-feature__num {
    display: block;
    font-family: var(--font-mono);
    font-weight: 500;
    font-size: 11px;
    line-height: 1;
    color: #0C7B82;
    letter-spacing: 0.08em;
  }
  .ec-feature__title {
    margin: 8px 0 0;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 18px;
    line-height: 1.3;
    letter-spacing: -0.01em;
    color: #0D1321;
  }
  .ec-feature__body {
    margin: 8px 0 0;
    font-family: var(--font-body);
    font-weight: 400;
    font-size: 15px;
    line-height: 1.65;
    color: #64748B;
    text-wrap: pretty;
  }

  /* ============================================================
     4. THE STANDARD (dark)
     ============================================================ */
  .ec-std { background: #0D1826; padding-block: 96px; }
  .ec-std .container { max-width: 960px; }
  .ec-std__eyebrow {
    margin: 0 0 16px;
    text-align: center;
    font-family: var(--font-mono);
    font-size: 11px;
    line-height: 1;
    color: #0C7B82;
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }
  .ec-std__title {
    margin: 0;
    text-align: center;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(28px, 1.5rem + 1.6vw, 36px);
    line-height: 1.2;
    letter-spacing: -0.02em;
    color: #FFFFFF;
    text-wrap: balance;
  }
  .ec-std__grid {
    margin-top: 48px;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }
  .ec-std-card {
    background: #0A1520;
    border: 0.5px solid #1E3A4A;
    border-radius: 16px;
    padding: 28px;
  }
  .ec-std-card__title {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 18px;
    line-height: 1.3;
    letter-spacing: -0.01em;
    color: #FFFFFF;
  }
  .ec-std-card__body {
    margin: 10px 0 0;
    font-family: var(--font-body);
    font-weight: 400;
    font-size: 14px;
    line-height: 1.65;
    color: #94A3B8;
    text-wrap: pretty;
  }

  /* ============================================================
     5. FAQ
     ============================================================ */
  .ec-faq { background: #FFFFFF; padding-block: 96px; }
  .ec-faq .container { max-width: 800px; }
  .ec-faq__eyebrow {
    margin: 0 0 16px;
    font-family: var(--font-mono);
    font-size: 11px;
    line-height: 1;
    color: #0C7B82;
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }
  .ec-faq__title {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(28px, 1.5rem + 1.6vw, 36px);
    line-height: 1.15;
    letter-spacing: -0.02em;
    color: #0D1321;
    text-wrap: balance;
  }
  .ec-faq__list {
    margin-top: 48px;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  /* ============================================================
     RESPONSIVE
     ============================================================ */
  @media (max-width: 56rem) {
    .ec-features { grid-template-columns: 1fr; gap: 28px; }
    .ec-std__grid { grid-template-columns: 1fr; }
  }
  @media (max-width: 48rem) {
    .ec-hero    { padding-block: 72px; }
    .ec-problem { padding-block: 72px; }
    .ec-do      { padding-block: 72px; }
    .ec-std     { padding-block: 72px; }
    .ec-faq     { padding-block: 72px; }
  }
</style>
