---
/**
 * TeamStrip.astro: founders' section.
 *
 * Dark band #0D1826, 96px top/bottom. Two white cards centred under
 * a single eyebrow + headline + intro paragraph. Stacks on mobile.
 */
import { Image } from 'astro:assets';
import tomPhoto from '../../assets/tom.webp';
import markPhoto from '../../assets/mark.webp';

const PEOPLE = [
  {
    name: 'Tom Watts',
    role: 'The maker',
    photo: tomPhoto,
    bio: 'Tom has spent two decades building, designing, and optimising websites — including years working with some of the world’s biggest news publishers, where search performance isn’t a nice-to-have, it’s the business. He brings that publisher-grade standard of technical SEO, site speed, and content structure to every Found Everywhere client.',
  },
  {
    name: 'Mark Reynolds',
    role: 'The strategist',
    photo: markPhoto,
    bio: 'Mark has an extensive background in SEO and digital strategy, having spent years driving organic growth for businesses across dozens of sectors. He lives and breathes search \u2014 from technical audits and site migrations to the new discipline of AI visibility \u2014 and knows exactly what it takes to get a business found.',
  },
] as const;
---

<section class="team" aria-labelledby="team-title">
  <div class="container">

    <header class="team__head">
      <p class="team__eyebrow">Who we are</p>
      <h2 id="team-title" class="team__title">Built by people who have done the work</h2>
      <p class="team__intro">
        Found Everywhere is Tom Watts and Mark Reynolds. Between us we have built
        hundreds of websites, run digital strategy for blue-chip brands, and spent
        more time in Search Console than we care to admit. We started this because
        the SEO industry was slow to notice that search had fundamentally changed.
        We were not.
      </p>
    </header>

    <div class="team__grid">
      {PEOPLE.map((person) => (
        <article class="team-card">
          <Image
            class="team-card__photo"
            src={person.photo}
            alt={`Portrait of ${person.name}`}
            width={120}
            height={120}
            loading="lazy"
            decoding="async"
          />
          <h3 class="team-card__name">{person.name}</h3>
          <p class="team-card__role">{person.role}</p>
          <p class="team-card__bio">{person.bio}</p>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  /* ============================================================
     SHELL
     ============================================================ */
  .team {
    background: #0D1826;
    color: #FFFFFF;
    padding-block: 96px;
  }

  /* ---------- Header block ---------- */
  .team__head { text-align: center; }
  .team__eyebrow {
    margin: 0 0 16px;
    font-family: var(--font-mono);
    font-size: 11px;
    line-height: 1;
    color: #3FA9B0;
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }
  .team__title {
    margin: 0 auto;
    max-width: 600px;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(28px, 1.6rem + 1.8vw, 36px);
    line-height: 1.15;
    letter-spacing: -0.02em;
    color: #FFFFFF;
    text-wrap: balance;
  }
  .team__intro {
    margin: 16px auto 0;
    max-width: 580px;
    font-family: var(--font-body);
    font-weight: 400;
    font-size: 16px;
    line-height: 1.65;
    color: #94A3B8;
    text-wrap: pretty;
  }

  /* ============================================================
     CARDS
     ============================================================ */
  .team__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 24px;
    max-width: 860px;
    margin: 56px auto 0;
  }

  .team-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    background: #FFFFFF;
    border-radius: 16px;
    padding: 32px;
  }

  .team-card__photo {
    width: 120px;
    height: 120px;
    border-radius: 50%;
    object-fit: cover;
    border: 3px solid #0C7B82;
    display: block;
  }

  .team-card__name {
    margin: 16px 0 0;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 18px;
    line-height: 1.2;
    letter-spacing: -0.01em;
    color: #0D1321;
  }

  .team-card__role {
    margin: 6px 0 0;
    font-family: var(--font-mono);
    font-size: 10px;
    line-height: 1;
    color: #0A6A70;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .team-card__bio {
    margin: 12px 0 0;
    font-family: var(--font-body);
    font-weight: 400;
    font-size: 14px;
    line-height: 1.65;
    color: #525D6B;
    text-align: center;
    text-wrap: pretty;
  }

  /* ============================================================
     MOBILE
     ============================================================ */
  @media (max-width: 48rem) {
    .team { padding-block: 64px; }
    .team__grid {
      grid-template-columns: 1fr;
      margin-top: 40px;
      gap: 20px;
      max-width: 28rem;
    }
    .team-card { padding: 28px; }
  }
</style>
